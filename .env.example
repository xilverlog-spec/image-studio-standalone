# 이 파일을 backend/.env로 복사한 뒤 값을 채우세요 (둘 다 기본값은 이 PC의 localhost).

# ComfyUI가 다른 PC(예: GPU가 더 좋은 PC)에서 돌고 있다면 그 PC의 IP로 바꾸세요.
COMFYUI_URL=http://localhost:8188

# Ollama가 다른 PC에서 돌고 있다면 그 PC의 IP로 바꾸세요.
OLLAMA_URL=http://localhost:11434

# ── 유료 API (선택) ─────────────────────────────────────────────────────────────
# 키는 이 파일이 아니라 backend/.env 에만 넣고, 채팅·메신저에 붙여넣지 마세요. 키가 없으면 해당 기능은 화면에 나타나지 않고 무료 기능만 동작합니다.

# 손스케치 '정밀 읽기'(유료): 결제가 연결된 Gemini 키 + 읽기용 상위 모델 ID 가 둘 다 있어야 버튼이 나타납니다.
# 키는 이미지 생성용 GEMINI_IMAGE_API_KEY 와 같은 키를 쓰면 되고, 따로 두려면 GEMINI_PAID_API_KEY 에 넣습니다.
# 모델 ID 는 공급자가 자주 바꾸므로 코드에 고정하지 않았습니다(Google AI Studio 의 모델 목록에서 확인).
GEMINI_PAID_API_KEY=
GEMINI_PAID_VISION_MODEL=
# 호출 1회의 예상 비용(USD, 대략치). 하루 한도(PAID_DAILY_LIMIT_USD, 기본 10)에 이미지 생성 비용과 합산됩니다.
PAID_COST_VISION_USD=0.03

# Google 이미지 생성(조감도 등) 해상도: 1K(약 100만 화소) / 2K(약 400만 화소, 1K 와 같은 요금) / 4K(약 1,600만 화소, 더 비쌈). 대문자 K 로 쓰며, 비우면 기본 2K 입니다.
# 4K 로 바꾸면 한 장 예상 비용이 PAID_COST_GEMINI_4K_USD(기본 0.24)로 계산됩니다.
GEMINI_IMAGE_SIZE=2K
